# Конфигурация LawVision
# Скопируйте этот файл в .env и заполните значения

# === База данных (PostgreSQL) ===
DATABASE_URL=postgresql://lawai:lawai_dev_2026@localhost:5432/lawai

# === LLM Provider ===
# Варианты: 'local' (централизованный vLLM-сервис), 'openai', 'ollama', 'finetuned'
LLM_PROVIDER_TYPE=local
LLM_MODEL=gemma4
TEMPERATURE=0.1
MAX_TOKENS=4000
TOP_K_RESULTS=5

# Локальный централизованный LLM-сервис (OpenAI-совместимый, vLLM)
# С самого сервера: http://localhost:8000/v1
# С других машин в сети: http://10.1.17.61:8000/v1
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=not-needed

# Ollama (устарело; если LLM_PROVIDER_TYPE=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (если LLM_PROVIDER_TYPE=openai)
# OPENAI_API_KEY=sk-...

# === Embeddings (централизованный сервис, OpenAI-совместимый, BGE-M3) ===
# С самого сервера: http://localhost:8002/v1; с других машин: http://10.1.17.61:8002/v1
EMBEDDING_BASE_URL=http://localhost:8002/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_RERANK_MODEL=bge-m3
USE_RERANK=true

# === Flask ===
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=False
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
